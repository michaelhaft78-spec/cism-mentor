# Kopieer dit bestand naar .env.local en vul de waarden in.

# Google AI Studio -> "Get API key"
GEMINI_API_KEY=

# Optioneel: vast model kiezen. Leeg = gemini-flash-latest (altijd het actuele Flash-model)
GEMINI_MODEL=

# Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# GEHEIM: alleen server-side gebruikt (cron). Nooit in de browser of in git.
SUPABASE_SERVICE_ROLE_KEY=

# Zelf verzonnen lange willekeurige string (bijv. via: openssl rand -hex 32)
CRON_SECRET=

# Jouw user id uit Supabase -> Authentication -> Users (na je eerste login)
DEFAULT_USER_ID=
